# VCK local dev configuration. DEV-ONLY placeholder values, never reuse them anywhere real.
# Copy to the repo-root .env (git-ignored) to override defaults.
# `make up` / `make down` read it. Run compose only via make:
# a hand-run `docker compose -f infra/...` will not see it.
# `make up` works without any .env (compose has the same defaults).
# First `make up` pulls ~6 images; the 90 s wait budget assumes they are present.
# Variables marked "app-facing" are consumed by later stories, which decide where
# each app loads its .env from (Medusa/Next read their own dirs, not this file).
# Compose variables must equal the defaults in infra/docker-compose.yml (tests enforce it).

# ---- PostgreSQL ----
# Host port (bound to 127.0.0.1).
POSTGRES_PORT=5432
# Database superuser.
POSTGRES_USER=vck
# Database password (dev only).
POSTGRES_PASSWORD=vck
# Default database name.
POSTGRES_DB=vck
# App-facing connection string; keep in sync with the four values above.
DATABASE_URL=postgres://vck:vck@localhost:5432/vck

# ---- Redis ----
# Host port (bound to 127.0.0.1).
REDIS_PORT=6379
# App-facing connection string.
REDIS_URL=redis://localhost:6379

# ---- Meilisearch ----
# Host port (bound to 127.0.0.1).
MEILI_PORT=7700
# App-facing base URL.
MEILI_HOST=http://localhost:7700
# Master key (dev only), used by both the container and the app.
MEILI_MASTER_KEY=dev-only-meili-key

# ---- MinIO (S3-compatible storage) ----
# Root user, also the S3 access key.
MINIO_ROOT_USER=vck
# Root password, also the S3 secret key (dev only).
MINIO_ROOT_PASSWORD=vck-dev-only
# Host S3 API port (9000 is reserved for backend-server).
MINIO_API_PORT=9002
# Host web console port.
MINIO_CONSOLE_PORT=9003
# App-facing S3 endpoint the app talks to (host API port above).
S3_ENDPOINT=http://localhost:9002
# Bucket created by minio-init.
S3_BUCKET=vck-media
# S3 access key id (= MINIO_ROOT_USER).
S3_ACCESS_KEY_ID=vck
# S3 secret access key (= MINIO_ROOT_PASSWORD).
S3_SECRET_ACCESS_KEY=vck-dev-only
# Region placeholder; MinIO ignores it but SDKs require one.
S3_REGION=vck-local
# MinIO needs path-style URLs (bucket in the path, not the hostname).
S3_FORCE_PATH_STYLE=true

# ---- Mailpit (fake SMTP inbox) ----
# Host SMTP port.
MAILPIT_SMTP_PORT=1025
# Host web UI port.
MAILPIT_UI_PORT=8025
# App-facing SMTP host the app sends to.
SMTP_HOST=localhost
# SMTP port the app sends to (= MAILPIT_SMTP_PORT).
SMTP_PORT=1025

# ---- Provider simulators ----
# VNPay simulator host port.
VNPAY_SIM_PORT=9100
# GHN simulator host port.
GHN_SIM_PORT=9101
