{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vn-commerce-kit.local/events/order-events.schema.json",
  "title": "Order events (guest self-service)",
  "description": "vck.order.guest_cancelled is emitted once per order after a verified guest cancel (ADR-014). refund.required is false for option A (COD only); option B sets it and names the refund adapter.",
  "type": "object",
  "required": ["name", "id", "occurred_at", "version", "data"],
  "properties": {
    "name": { "const": "vck.order.guest_cancelled" },
    "id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "version": { "const": 1 },
    "trace_id": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["order_id", "display_id", "reason_code", "payment_method", "restocked", "refund"],
      "properties": {
        "order_id": { "type": "string" },
        "display_id": { "type": "string" },
        "reason_code": { "enum": ["changed_mind", "wrong_item_or_size", "found_better_price", "duplicate_order", "delivery_too_slow", "other"] },
        "payment_method": { "enum": ["cod", "vnpay", "vietqr"] },
        "restocked": { "type": "boolean" },
        "refund": {
          "type": "object",
          "required": ["required"],
          "properties": { "required": { "type": "boolean" }, "adapter": { "type": "string" }, "amount": { "type": "integer", "minimum": 0 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
