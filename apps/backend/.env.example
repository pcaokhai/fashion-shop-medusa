# Backend dev config. DEV-ONLY placeholders; copy to apps/backend/.env (git-ignored). Real secrets live in the password manager.
STORE_CORS=http://localhost:8000,http://localhost:8001
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:8001
DATABASE_URL=postgres://vck:vck@localhost:5432/vck
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-jwt-secret
COOKIE_SECRET=dev-only-cookie-secret
# Dev admin (used by `make admin`); change on any shared host.
MEDUSA_ADMIN_EMAIL=admin@vck.local
MEDUSA_ADMIN_PASSWORD=dev-only-admin-pw
# Order confirmation mail (Mailpit locally, UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=VN Commerce Kit <no-reply@vck.local>
# VNPay. DEV placeholders point at the local simulator (make up, port 9100). The sandbox TMN code and hash secret come from
# the VNPay merchant portal and live only in your password manager / real .env, never in chat or git.
VNPAY_TMN_CODE=VCKTEST1
VNPAY_HASH_SECRET=TESTSECRETVCK0000000000000000000
VNPAY_PAY_URL=http://localhost:9100/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8000/checkout/vnpay-return
